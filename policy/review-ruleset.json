{
  "name": "GitOps path-scoped human review",
  "target": "branch",
  "enforcement": "active",
  "bypass_actors": [],
  "conditions": {
    "ref_name": {
      "include": [
        "refs/heads/main"
      ],
      "exclude": []
    }
  },
  "rules": [
    {
      "type": "pull_request",
      "parameters": {
        "required_approving_review_count": 0,
        "dismiss_stale_reviews_on_push": true,
        "require_code_owner_review": false,
        "require_last_push_approval": false,
        "required_review_thread_resolution": true,
        "required_reviewers": [
          {
            "minimum_approvals": 1,
            "file_patterns": [
              "**",
              "!environments/dev/release.json",
              "!environments/qa/release.json"
            ],
            "reviewer": {
              "id": 20254182,
              "type": "Team"
            }
          }
        ]
      }
    }
  ]
}
