{
  "apiVersion": "v1",
  "kind": "List",
  "items": [
    {
      "apiVersion": "argoproj.io/v1alpha1",
      "kind": "AppProject",
      "metadata": {
        "name": "narx-commerce-local",
        "namespace": "argocd"
      },
      "spec": {
        "description": "Narx commerce local delivery; no cluster-wide resource permissions",
        "sourceRepos": [
          "https://github.com/Narx-Space-Prod/platform-gitops.git"
        ],
        "destinations": [
          {
            "server": "https://kubernetes.default.svc",
            "namespace": "commerce-dev"
          },
          {
            "server": "https://kubernetes.default.svc",
            "namespace": "commerce-qa"
          }
        ],
        "clusterResourceWhitelist": [],
        "namespaceResourceWhitelist": [
          {
            "group": "",
            "kind": "ConfigMap"
          },
          {
            "group": "",
            "kind": "Service"
          },
          {
            "group": "",
            "kind": "ServiceAccount"
          },
          {
            "group": "",
            "kind": "PersistentVolumeClaim"
          },
          {
            "group": "apps",
            "kind": "Deployment"
          },
          {
            "group": "apps",
            "kind": "StatefulSet"
          },
          {
            "group": "batch",
            "kind": "Job"
          },
          {
            "group": "policy",
            "kind": "PodDisruptionBudget"
          },
          {
            "group": "autoscaling",
            "kind": "HorizontalPodAutoscaler"
          },
          {
            "group": "networking.k8s.io",
            "kind": "NetworkPolicy"
          },
          {
            "group": "argoproj.io",
            "kind": "Rollout"
          },
          {
            "group": "argoproj.io",
            "kind": "AnalysisTemplate"
          },
          {
            "group": "rbac.authorization.k8s.io",
            "kind": "Role"
          },
          {
            "group": "rbac.authorization.k8s.io",
            "kind": "RoleBinding"
          }
        ],
        "orphanedResources": {
          "warn": true
        }
      }
    },
    {
      "apiVersion": "argoproj.io/v1alpha1",
      "kind": "ApplicationSet",
      "metadata": {
        "name": "narx-commerce-local",
        "namespace": "argocd"
      },
      "spec": {
        "goTemplate": true,
        "goTemplateOptions": [
          "missingkey=error"
        ],
        "generators": [
          {
            "list": {
              "elements": [
                {
                  "environment": "dev"
                },
                {
                  "environment": "qa"
                }
              ]
            }
          }
        ],
        "template": {
          "metadata": {
            "name": "narx-commerce-{{.environment}}",
            "labels": {
              "delivery.narx.space/environment": "{{.environment}}"
            },
            "annotations": {
              "notifications.argoproj.io/subscribe.narx-pending.github": "",
              "notifications.argoproj.io/subscribe.narx-healthy.github": "",
              "notifications.argoproj.io/subscribe.narx-failed.github": "",
              "notifications.argoproj.io/subscribe.narx-slack-deployed.webhook": "slack",
              "notifications.argoproj.io/subscribe.narx-slack-failed.webhook": "slack"
            }
          },
          "spec": {
            "project": "narx-commerce-local",
            "source": {
              "repoURL": "https://github.com/Narx-Space-Prod/platform-gitops.git",
              "targetRevision": "main",
              "path": "charts/commerce",
              "helm": {
                "releaseName": "commerce",
                "valueFiles": [
                  "../../environments/{{.environment}}/runtime.yaml",
                  "../../environments/{{.environment}}/release.json"
                ]
              }
            },
            "destination": {
              "server": "https://kubernetes.default.svc",
              "namespace": "commerce-{{.environment}}"
            },
            "syncPolicy": {
              "automated": {
                "prune": true,
                "selfHeal": true,
                "allowEmpty": false
              },
              "syncOptions": [
                "ServerSideApply=true",
                "PruneLast=true",
                "RespectIgnoreDifferences=true"
              ],
              "retry": {
                "limit": 3,
                "backoff": {
                  "duration": "10s",
                  "factor": 2,
                  "maxDuration": "1m"
                }
              }
            },
            "ignoreDifferences": [
              {
                "group": "",
                "kind": "Service",
                "jqPathExpressions": [
                  ".spec.selector.\"rollouts-pod-template-hash\""
                ]
              }
            ]
          }
        },
        "syncPolicy": {
          "applicationsSync": "create-update",
          "preserveResourcesOnDeletion": true
        }
      }
    }
  ]
}
